DATABASE_URL=""                 # App/runtime database connection string
DIRECT_URL=""                   # Direct database connection for Prisma CLI/migrations
SESSION_SECRET=""               # Session signing secret

GITHUB_CLIENT_ID=""             # GitHub OAuth app client ID
GITHUB_CLIENT_SECRET=""         # GitHub OAuth app client secret
GITHUB_CALLBACK_URL=""          # GitHub OAuth callback URL

TELEGRAM_BOT_TOKEN=""           # Telegram bot token for login widget
TELEGRAM_BOT_USERNAME=""        # Telegram bot username without @ (e.g. frogger_authbot)
TELEGRAM_BOT_INTERNAL_URL=""    # Optional internal bot service URL (defaults to http://127.0.0.1:3001)

FRONTEND_URL=""                 # Frontend base URL for auth redirects
CORS_ORIGIN=""                  # Allowed frontend origin for CORS

NODE_ENV="development"          # development | production
PORT="3000"                     # Backend port
BOT_PORT="3001"                 # Internal Telegram bot service port
