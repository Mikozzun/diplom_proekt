generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           BigInt   @id @default(autoincrement())
  username     String   @unique
  phoneNumber  String   @map("phone_number")
  passkey      String
  profileImage String?  @map("profile_image")
  clerkId      String?  @unique @map("clerk_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  posts              Post[]
  comments           Comment[]
  likes              Like[]
  bookmarks          Bookmark[]
  reactions          Reaction[]
  notifications      Notification[]
  files              Storage[]
  settings           UserSettings?
  activityLog        UserActivityLog[]
  pollResponses      PollResponse[]
  reports            Report[]
  userRoles          UserRole[]
  admin              Admin?
  randomizations     UserPostRandomization[]
  sessions           Session[]
  passkeyCredentials PasskeyCredential[]

  @@map("users")
}

model Post {
  id        BigInt    @id @default(autoincrement())
  content   String?
  imageUrl  String?   @map("image_url")
  videoUrl  String?   @map("video_url")
  userId    BigInt?   @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  user           User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments       Comment[]
  likes          Like[]
  bookmarks      Bookmark[]
  reactions      Reaction[]
  polls          Poll[]
  randomizations UserPostRandomization[]

  @@map("posts")
}

model Comment {
  id        BigInt    @id @default(autoincrement())
  content   String
  userId    BigInt?   @map("user_id")
  postId    BigInt?   @map("post_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @map("updated_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Like {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt?  @map("user_id")
  postId    BigInt?  @map("post_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("likes")
}

model Bookmark {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt?  @map("user_id")
  postId    BigInt?  @map("post_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("bookmarks")
}

model Reaction {
  id           BigInt   @id @default(autoincrement())
  reactionType String   @map("reaction_type")
  userId       BigInt?  @map("user_id")
  postId       BigInt?  @map("post_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, reactionType])
  @@map("reactions")
}

model Notification {
  id        BigInt    @id @default(autoincrement())
  message   String
  type      String
  userId    BigInt?   @map("user_id")
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Storage {
  id        BigInt   @id @default(autoincrement())
  fileName  String   @map("file_name")
  fileType  String   @map("file_type")
  fileSize  BigInt   @map("file_size")
  fileUrl   String   @map("file_url")
  userId    BigInt?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("storage")
}

model UserSettings {
  id                   BigInt   @id @default(autoincrement())
  userId               BigInt?  @unique @map("user_id")
  theme                String?  @default("light")
  notificationsEnabled Boolean? @default(true) @map("notifications_enabled")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model UserActivityLog {
  id        BigInt   @id @default(autoincrement())
  action    String
  userId    BigInt?  @map("user_id")
  timestamp DateTime @default(now()) @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_activity_log")
}

model Poll {
  id        BigInt   @id @default(autoincrement())
  question  String
  options   Json
  postId    BigInt?  @map("post_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  post      Post?          @relation(fields: [postId], references: [id], onDelete: Cascade)
  responses PollResponse[]

  @@map("polls")
}

model PollResponse {
  id             BigInt   @id @default(autoincrement())
  selectedOption String   @map("selected_option")
  pollId         BigInt?  @map("poll_id")
  userId         BigInt?  @map("user_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  poll Poll? @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@map("poll_responses")
}

model Report {
  id          BigInt   @id @default(autoincrement())
  reportType  String   @map("report_type")
  description String?
  userId      BigInt?  @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model Role {
  id   BigInt @id @default(autoincrement())
  name String @unique

  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  id     BigInt  @id @default(autoincrement())
  userId BigInt? @map("user_id")
  roleId BigInt? @map("role_id")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role? @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Admin {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt?  @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

model ModerationQueue {
  id          BigInt   @id @default(autoincrement())
  contentType String   @map("content_type")
  contentId   BigInt   @map("content_id")
  status      String?  @default("pending")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("moderation_queue")
}

model DailyMetrics {
  id           BigInt   @id @default(autoincrement())
  date         DateTime @unique @db.Date
  newUsers     Int?     @default(0) @map("new_users")
  activeUsers  Int?     @default(0) @map("active_users")
  postsCreated Int?     @default(0) @map("posts_created")
  commentsMade Int?     @default(0) @map("comments_made")

  @@map("daily_metrics")
}

model UserPostRandomization {
  id          BigInt   @id @default(autoincrement())
  randomOrder Int      @map("random_order")
  userId      BigInt?  @map("user_id")
  postId      BigInt?  @map("post_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("user_post_randomization")
}

model Session {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt   @map("user_id")
  refreshToken String   @map("refresh_token")
  deviceInfo   String?  @map("device_info")
  ipAddress    String?  @map("ip_address")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz
  lastActive   DateTime @default(now()) @map("last_active") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model PasskeyCredential {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt   @map("user_id")
  credentialId String   @unique @map("credential_id")
  publicKey    String   @map("public_key")
  counter      BigInt   @default(0)
  deviceType   String?  @map("device_type")
  backedUp     Boolean  @default(false)
  transports   String[] @default([])
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("passkey_credentials")
}
