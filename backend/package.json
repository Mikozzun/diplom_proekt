{
  "name": "frogger-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenvx run -- tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "start": "dotenvx run -- tsx src/index.ts",
    "test": "jest --selectProjects unit --forceExit --detectOpenHandles",
    "test:coverage": "jest --selectProjects unit --coverage --forceExit --detectOpenHandles",
    "test:e2e": "dotenvx run -- jest --selectProjects e2e --forceExit --runInBand",
    "test:all": "dotenvx run -- jest --forceExit --runInBand",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "seed": "dotenvx run -- tsx prisma/seed.ts",
    "e2e": "dotenvx run -- tsx e2e/api.test.ts",
    "e2e:connectivity": "dotenvx run -- tsx e2e/connectivity.test.ts",
    "vercel-build": "prisma generate",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@adminjs/express": "^6.1.1",
    "@adminjs/sql": "^2.2.6",
    "@dotenvx/dotenvx": "^1.30.0",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@simplewebauthn/server": "^11.0.0",
    "adminjs": "^7.8.17",
    "bcryptjs": "^2.4.3",
    "better-auth": "^1.5.6",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.0",
    "express-formidable": "^1.2.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.19.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.20.0",
    "tslib": "^2.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.4.0",
    "prisma": "^7.6.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  }
}
